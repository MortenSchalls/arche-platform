{
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "Strict-Transport-Security",
     "value": "max-age=63072000; includeSubDomains; preload"
    },
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "X-Frame-Options",
     "value": "DENY"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "Permissions-Policy",
     "value": "camera=(), microphone=(self), geolocation=(), payment=(), usb=(), interest-cohort=(), browsing-topics=()"
    },
    {
     "key": "Cross-Origin-Opener-Policy",
     "value": "same-origin-allow-popups"
    },
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    },
    {
     "key": "Content-Security-Policy-Report-Only",
     "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://cdn.jsdelivr.net; media-src 'self' blob: data:; worker-src 'self' blob:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
    }
   ]
  },
  {
   "source": "/api/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-store"
    }
   ]
  },
  {
   "source": "/((?!api/).*)\\.html",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache, must-revalidate"
    }
   ]
  },
  {
   "source": "/",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache, must-revalidate"
    }
   ]
  }
 ],
 "rewrites": [
  {
   "source": "/website/:path*",
   "destination": "/api/site?p=:path*"
  }
 ],
 "redirects": [
  {
   "source": "/website",
   "destination": "/website/",
   "permanent": false
  },
  {
   "source": "/api/_site/:path*",
   "destination": "/",
   "permanent": false
  }
 ]
}