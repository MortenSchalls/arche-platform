{
 "headers": [
  {
   "source": "/(.*)",
   "has": [
    {
     "type": "host",
     "value": ".*\\.vercel\\.app"
    }
   ],
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    }
   ]
  },
  {
   "source": "/(img|assets|vendor)/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=2592000"
    }
   ]
  }
 ]
}